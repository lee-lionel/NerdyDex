# Airtable credentials.
#
# WARNING: REACT_APP_* values are inlined into the built JavaScript and are
# therefore PUBLIC in the deployed app. Anyone can read this token and use it
# against the base. Scope it to this base only, and move these calls behind a
# server if the data matters.
REACT_APP_AIRTABLE_API_KEY=your_personal_access_token_here
REACT_APP_AIRTABLE_BASE_ID=app2Zq6DikKlO4AV3
